[Unit]
Description=Nextwaves RFID Gate Service
Requires=docker.service
After=docker.service
# Restart behaviour is owned by Docker (restart: unless-stopped in compose.yaml);
# this oneshot unit only brings the Compose project up and down.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nextwaves-gate/deploy
EnvironmentFile=/opt/nextwaves-gate/deploy/gate.env
ExecStartPre=/bin/sh /opt/nextwaves-gate/deploy/wait-for-devices.sh
ExecStart=/usr/bin/docker compose --env-file gate.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file gate.env down --timeout 30
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
