{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextwaves.example/rfid-portal/mqtt/v1/response-envelope.schema.json",
  "title": "RFID Portal MQTT SDK response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "command",
    "accepted",
    "occurred_at",
    "gate_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string" },
    "command": { "type": "string" },
    "accepted": { "type": "boolean" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "gate_id": { "type": "string" },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": true } } },
      "then": { "required": ["result"] },
      "else": { "required": ["error"] }
    }
  ]
}
